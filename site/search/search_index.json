{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u592a\u543e\u540c\u4eba TRPG \u89c4\u5219","text":"<p>\u613f\u6bcf\u4e00\u6b21\u9ab0\u5b50\u843d\u4e0b\uff0c\u90fd\u6210\u4e3a\u4e00\u6bb5\u6c5f\u6e56\u4f20\u95fb\u7684\u5f00\u7aef\u3002</p> <p>\u6b22\u8fce\u6765\u5230\u300a\u592a\u543e\u7ed8\u5377\u300b\u540c\u4eba TRPG \u89c4\u5219\u624b\u518c\u3002\u8fd9\u91cc\u4f1a\u9010\u6b65\u6574\u7406\u4e16\u754c\u89c2\u3001\u89d2\u8272\u521b\u5efa\u3001\u68c0\u5b9a\u3001\u6218\u6597\u3001\u529f\u6cd5\u4e0e\u9053\u5177\u7b49\u5185\u5bb9\uff0c\u65b9\u4fbf\u9605\u8bfb\u3001\u68c0\u7d22\u4e0e\u7ebf\u4e0a\u5206\u4eab\u3002</p>"},{"location":"#_1","title":"\u5f53\u524d\u7ae0\u8282","text":"\u7ae0\u8282 \u5185\u5bb9 \u5199\u5728\u524d\u9762 \u89c4\u5219\u8bf4\u660e\u3001\u7075\u611f\u6765\u6e90\u3001\u7b26\u53f7\u6807\u8bb0\u4e0e\u66f4\u65b0\u8bb0\u5f55 \u592a\u543e\u4e16\u754c \u54c1\u7ea7\u3001D6 \u68c0\u5b9a\u3001\u9608\u503c\u3001\u51c0\u6210\u529f\u4e0e\u534f\u52a9\u89c4\u5219 \u89d2\u8272\u6982\u8ff0 \u89d2\u8272\u76f8\u5173\u89c4\u5219\u7684\u6574\u7406\u5165\u53e3 <p>\u6574\u7406\u8bf4\u660e</p> <p>\u8fd9\u662f\u7f51\u9875\u7248\u89c4\u5219\u7684\u521d\u59cb\u9aa8\u67b6\u3002\u540e\u7eed\u65b0\u589e\u7ae0\u8282\u65f6\uff0c\u53ea\u9700\u8981\u628a\u6574\u7406\u597d\u7684 Markdown \u653e\u5165 <code>docs/</code>\uff0c\u518d\u5728\u6839\u76ee\u5f55\u7684 <code>mkdocs.yml</code> \u4e2d\u8865\u5145 <code>nav</code> \u9879\u5373\u53ef\u3002</p>"},{"location":"chap00_intro/","title":"\u540c\u4eba\u4ecb\u7ecd","text":"<p>\u9996\u5148\uff0c\u611f\u8c22\u5404\u4f4d\u9605\u8bfb\u300a\u592a\u543e\u7ed8\u5377\u300b\u540c\u4ebaTRPG\uff01</p> <p>\u672c\u89c4\u5219\u7684\u4e3b\u8981\u7075\u611f\u3001\u4e16\u754c\u8bbe\u5b9a\u3001\u6b66\u529f\u7edd\u5b66\u7b49\u5c3d\u6570\u6765\u81ea\u300a\u592a\u543e\u7ed8\u5377\u300b\uff0c\u5e76\u5728\u6e38\u620f\u7684\u57fa\u7840\u4e0a\u53bb\u9664\u4e86\u53d1\u6325\u5ea6\u3001\u6b21\u8981\u5c5e\u6027\u7b49\u6d89\u53ca\u767e\u5206\u6bd4\u8ba1\u7b97\u7684\u5185\u5bb9\uff0c\u8f6c\u6362\u4e3a\u4e86\u6709\u6216\u65e0\u7684\u8d44\u6e90\u9009\u53d6\uff0c\u5e76\u5bf9\u5404\u79cd\u517b\u6210\u8981\u7d20\u8fdb\u884c\u4e86\u7b80\u5316\uff0c\u610f\u56fe\u4ee5\u8ba1\u7b97\u7b80\u5355\u4f46\u9009\u62e9\u4e30\u5bcc\u7684\u89c4\u5219\uff0c\u5728\u684c\u9762\u4e0a\u6216\u7f51\u56e2\u4e2d\uff0c\u91cd\u73b0\u4e00\u90e8\u5206\u300a\u592a\u543e\u7ed8\u5377\u300b\u6b66\u4fa0\u6545\u4e8b\u7684\u4e50\u8da3\u3002</p> <p>\u672c\u89c4\u5219\u7684\u68c0\u5b9a\u548c\u6e38\u73a9\u65b9\u5f0f\uff0c\u8f83\u591a\u53c2\u8003\u4e86\u300a\u6697\u5f71\u72c2\u5954\u300b\u7684D6\u6a21\u5f0f\uff0c\u76f8\u8f83\u4e8eD20\u6216D100\u7684\u7ebf\u6027\u5206\u5e03\uff0c\u57fa\u4e8e\u4e8c\u9879\u5206\u5e03\u7684D6\u6210\u529f\u5ea6\u7cfb\u7edf\u66f4\u52a0\u7a33\u5b9a\uff0c\u5176\u7279\u6709\u7684\u5148\u653b\u6a21\u5f0f\u4e5f\u80fd\u4e00\u5b9a\u7a0b\u5ea6\u4e0a\u63d0\u4f9b\u66f4\u52a0\u7d27\u51d1\u7684\u4eba\u7269\u5bf9\u6297\u3002</p> <p>\u53e6\u4e00\u65b9\u9762\uff0c\u7531\u4e8e\u5728\u8bb8\u591a\u7684\u6b66\u4fa0\u6545\u4e8b\u7684\u5370\u8c61\u4e2d\uff0c\u6218\u6597\u5927\u591a\u4ee5\u8fd1\u8ddd\u79bb\u8fc7\u62db\u548c\u76f8\u4e92\u5468\u65cb\u4e3a\u4e3b\uff0c\u53cc\u65b9\u4ea4\u6218\u7684\u5730\u70b9\u662f\u4e00\u9a6c\u5e73\u5ddd\u7684\u9614\u5730\u3001\u6c89\u6d6e\u6e56\u9762\u7684\u5c0f\u821f\u3001\u6291\u6216\u662f\u968f\u98ce\u98d8\u8361\u7684\u7af9\u6797\u9876\u7aef\uff0c\u5176\u5e26\u6765\u7684\u66f4\u591a\u662f\u753b\u98ce\u4e0a\u7684\u5dee\u5f02\u800c\u975e\u6218\u68cb\u5c42\u9762\u7684\u63a9\u853d\u3001\u56f0\u96be\u5730\u5f62\u7b49\uff0c\u6240\u4ee5\uff0c\u672c\u89c4\u5219\u5728\u5730\u56fe\u548c\u79fb\u52a8\u65b9\u9762\u505a\u51fa\u4e86\u7b80\u5316\uff0c\u610f\u56fe\u91cd\u73b0\u300a\u592a\u543e\u7ed8\u5377\u300b\u4e2d\u4ee5\u53cc\u65b9\u8ddd\u79bb\u51b3\u5b9a\u76f8\u5bf9\u4f4d\u7f6e\u5173\u7cfb\u7684\u73a9\u6cd5\u3002</p> <p>\u7531\u4e8e\u672c\u4eba\u6c34\u5e73\u6709\u9650\uff0c\u672c\u89c4\u5219\u4e5f\u672a\u8fdb\u884c\u8db3\u591f\u7684\u6d4b\u8bd5\uff0c\u5b83\u5f88\u53ef\u80fd\u5b58\u5728\u6709\u5927\u91cfBug\u4e0e\u4e0d\u8db3\u4e4b\u5904\u3002\u5e0c\u671b\u8bfb\u8005\u4eec\u591a\u591a\u5305\u6db5\uff0c\u5e76\u5728\u6e38\u73a9\u65f6\u4e0e\u4f60\u7684GM\u548cPC\u5171\u540c\u8ba8\u8bba\uff0c\u4e5f\u6073\u8bf7\u5404\u4f4d\u5c06\u6e38\u73a9\u540e\u7684\u53cd\u9988\u901a\u8fc7\u3010\u94fe\u63a5\u3011\u63d0\u4f9b\u7ed9\u6211\uff0c\u611f\u6fc0\u4e0d\u5c3d\uff01</p> <p>\u8bdd\u4e0d\u591a\u8bf4\uff0c\u4eab\u53d7\u8dd1\u56e2\u7684\u4e50\u8da3\u5427\uff01</p> <p>By \u732a\u4e4b\u54c0\u4f24\uff0c\u57fa\u4e8eCC BY-NC-SA\u534f\u8bae\u5206\u4eab</p> <p>\u7b26\u53f7\u6807\u8bb0\uff1a</p> <p>\u3010\u3011\uff1a\u6807\u8bb0\u51fa\u5173\u952e\u89c4\u5219\u540d\u8bcd\uff0c\u4e00\u822c\u5728\u9996\u6b21\u63d0\u53ca\u65f6\u4f7f\u7528</p> <p>\u300c\u592a\u7956\u957f\u62f3\u300d\uff1a\u5f15\u7528\u5177\u540d\u7684\u73a9\u5bb6\u8d44\u6e90\uff0c\u5305\u62ec\u9053\u5177\u3001\u6280\u827a\u3001\u529f\u6cd5\u3001\u7279\u8d28\u7b49</p> <p><code>\u201c\u89d2\u8272\u521b\u5efa\u201d</code>\uff1a\u5f15\u7528\u672c\u6587\u4e2d\u7684\u5176\u4ed6\u7ae0\u8282</p> <p><code>[  ]</code>\uff1a\u6570\u503c\u8ba1\u7b97\u516c\u5f0f</p> <p>A \u00b7 B\uff1aB\u662fA\u7684\u5b50\u9879\u76ee\uff0c\u4f8b\u5982\u2014\u2014\u590d\u6742\u52a8\u4f5c \u00b7 \u8fd1\u6218\u653b\u51fb\uff0c\u8868\u793a\u590d\u6742\u52a8\u4f5c\u7c7b\u522b\u4e0b\u7684\u8fd1\u6218\u653b\u51fb\u52a8\u4f5c</p> <p>A \\ B\uff1a\u6807\u8bc6\u7b26A\u548cB\u7684\u5e76\u5217\uff0c\u8868\u793aA\u548cB\u540c\u65f6\u5177\u5907\uff0c\u4f8b\u5982\u2014\u2014\u5c11\u6797\u6d3e \\ \u50ac\u7834 \u00b7 \u62f3\u6cd5 \\ \u4eea\u5f0f\uff0c\u8868\u793a\u8be5\u529f\u6cd5\u5c5e\u4e8e\u5c11\u6797\u6d3e\u3001\u5c5e\u4e8e\u50ac\u7834\u529f\u6cd5\u7684\u62f3\u6cd5\u5b50\u7c7b\u3001\u5c5e\u4e8e\u4eea\u5f0f\u7c7b\u529f\u6cd5</p> <p>A / B\uff1a\u6570\u503cA\u548cB\u7684\u5e76\u5217\uff0c\u8868\u793a\u5728\u4e0d\u540c\u60c5\u51b5\u4e0b\u5206\u522b\u4f7f\u7528A\u6216B\uff0c\u8f83\u5c11\u51fa\u73b0</p> <p>\u66f4\u65b0\u65e5\u5fd7\uff1a</p> <p>V0.1\uff1a</p> <p>\u5f85\u5b9a</p> <p>FVTT\u7cfb\u7edf\uff1a</p> <p>\u5f85\u5b9a</p>"},{"location":"chap01_stats/","title":"\u89d2\u8272\u6982\u8ff0","text":""},{"location":"chap01_world/","title":"\u592a\u543e\u7ed8\u5377\u7684\u4e16\u754c","text":""},{"location":"chap01_world/#_2","title":"\u4ee5\u54c1\u8bba\u7269","text":"<p>\u5728\u592a\u543e\u7684\u4e16\u754c\u91cc\uff0c\u65e0\u8bba\u662f\u88c5\u5907\u3001\u9053\u5177\uff0c\u8fd8\u662f\u529f\u6cd5\u3001\u6280\u827a\uff0c\u751a\u81f3\u662f\u4eba\u7269\u7684\u5c5e\u6027\u548c\u5b9e\u529b\uff0c\u90fd\u53ef\u4ee5\u5206\u4e3a\u4e00\u54c1\u5230\u4e5d\u54c1\uff0c\u5171\u4e5d\u4e2a \u3010\u54c1\u7ea7\u3011 \u3002\u54c1\u7ea7\u8d8a\u5c0f\uff0c\u4ee3\u8868\u7740\u4e8b\u7269\u66f4\u7a00\u6709\uff0c\u66f4\u5f3a\u5927\u3002</p> <p>\u624b\u65e0\u7f1a\u9e21\u4e4b\u529b\u7684\u5e7c\u7ae5\u4e5f\u6709\u4e5d\u54c1\u7684\u8182\u529b\uff0c\u800c\u53f2\u4e0a\u6700\u52c7\u731b\u7684\u6b66\u58eb\u81f3\u591a\u53ea\u6709\u4e00\u54c1\u7684\u8182\u529b\u3002\u6211\u4eec\u7528 <code>1~9</code> \u5171\u4e5d\u4e2a \u3010\u7b49\u7ea7\u3011 \u6765\u4ee3\u8868\u4e00\u4e2a\u4e8b\u7269\u7684\u54c1\u7ea7\uff0c\u54c1\u7ea7\u4ee5\u6c49\u5b57\u6570\u5b57\u8868\u793a\uff0c\u6570\u5b57\u8d8a\u63a5\u8fd1\u4e00\u8d8a\u5f3a\u5927\uff0c \u3010\u7b49\u7ea7\u3011 \u4ee5\u963f\u62c9\u4f2f\u6570\u5b57\u8868\u793a\uff0c\u6570\u503c\u8d8a\u5927\u8d8a\u5f3a\u5927\u3002\u4f8b\u5982\uff0c\u7b49\u7ea71\u5bf9\u5e94\u4e5d\u54c1\u3001\u7b49\u7ea75\u5bf9\u5e94\u4e94\u54c1\u3001\u7b49\u7ea79\u5bf9\u5e94\u4e00\u54c1\u3002</p> <p>\u7531\u4e8e\u6295\u9ab0\u65f6\u6d89\u53ca\u6570\u5b57\u52a0\u51cf\uff0c\u4e3a\u907f\u514d\u6df7\u6dc6\uff0c\u672c\u89c4\u5219\u4e2d\u7edf\u4e00\u4f7f\u7528\u66f4\u7b26\u5408\u76f4\u89c9\u7684\u963f\u62c9\u4f2f\u6570\u5b57\uff0c\u5373 \u3010\u7b49\u7ea7\u3011 \u3002</p> <p>\u6ce8\uff1a\u4e3a\u907f\u514d\u6df7\u6dc6\uff0c\u672c\u89c4\u5219\u4e2d\u73a9\u5bb6\u7528\u5230\u7684\u7edd\u5927\u90e8\u5206\u7684\u6570\u503c\u53d6\u6574\u5747\u4e3a\u5411\u4e0a\u53d6\u6574\u3002</p>"},{"location":"chap01_world/#d6","title":"D6 \u68c0\u5b9a","text":""},{"location":"chap01_world/#_3","title":"\u9ab0\u6c60\u3001\u6210\u529f\u3001\u5931\u8d25","text":"<p>\u672c\u89c4\u5219\u53ea\u4f7f\u7528\u516d\u9762\u9ab0\u8fdb\u884c\u6e38\u620f\u3002\u5f53 GM \u8981\u6c42\u68c0\u5b9a\u65f6\uff0cPC\u6295\u63b7\u7279\u5b9a\u4e2a\u6570\u7684\u516d\u9762\u9ab0\uff0c\u8bb0\u505a <code>[xD6]</code> \uff0c\u9ab0\u5b50\u7684\u4e2a\u6570<code>x</code>\u88ab\u79f0\u4f5c\u672c\u6b21\u68c0\u5b9a\u7684 \u3010\u9ab0\u6c60\u3011 \uff0c\u901a\u5e38\u7531\u53d1\u8d77\u68c0\u5b9a\u8005\u7684 <code>[\u5c5e\u6027\u7b49\u7ea7 + \u6280\u80fd\u7b49\u7ea7 + \u5176\u4ed6\u8c03\u6574]</code> \u51b3\u5b9a\u3002</p> <p>\u6295\u9ab0\u540e\uff0c\u6bcf\u4e2a\u51fa\u73b0\u7684\u548c\u8bb0\u4e3a 1\u4e2a \u3010\u6210\u529f\u3011 \uff0c\u6bcf\u4e2a\u51fa\u73b0\u7684\u8bb0\u4e3a 1\u4e2a \u3010\u5931\u8d25\u3011 \uff0c\u7edf\u8ba1\u6210\u529f\u548c\u5931\u8d25\u7684\u603b\u6570\u4f5c\u4e3a\u68c0\u5b9a\u7684\u7ed3\u679c\u3002</p> <p>\u4f8b\u5982\u4e00\u540d\u8182\u529b3\u7ea7\uff087\u54c1\uff09\u3001\u5251\u6cd54\u7ea7\uff086\u54c1\uff09\u7684\u89d2\u8272\u4ee5\u5251\u6267\u884c\u4e00\u6b21\u529b\u9053\u653b\u51fb\uff0c\u4ed6\u8fdb\u884c\u547d\u4e2d\u68c0\u5b9a\uff0c\u6295\u63b7\uff1a <code>[3+4=7]</code> \u4e2a\u516d\u9762\u9ab0\u3002 \u4ed6\u5728\u6b64\u6b21\u68c0\u5b9a\u4e2d\u5f97\u5230\u4e86 <code>1,1,2,3,5,6,6</code> \uff0c\u8bb0\u4f5c2\u4e2a\u5931\u8d25\u30013\u4e2a\u6210\u529f\u3002</p> <p>\u5feb\u901f\u68c0\u5b9a</p> <p>\u82e5\u4e3a\u8282\u7701\u65f6\u95f4\uff0cGM\u80fd\u7b80\u5355\u5730\u4e3a\u68c0\u5b9a\u7ed3\u679c\u53d6\u4e00\u4e2a\u5408\u7406\u7684\u671f\u671b\uff0c\u4e00\u822c\u4e3a <code>[\u9ab0\u6c60/3]</code> \u3002\u8fd9\u901a\u5e38\u7528\u4e8e\u4e0d\u91cd\u8981\u7684\u5267\u60c5\u586b\u5145\uff0c\u6216\u662f\u5feb\u901f\u7ed3\u7b97\u5927\u91cf\u4e0d\u5173\u952e\u7684\u55bd\u5570\u654c\u4eba\u7684\u68c0\u5b9a\u3002</p>"},{"location":"chap01_world/#_4","title":"\u9608\u503c\u4e0e\u51c0\u6210\u529f","text":"<p>\u5927\u591a\u884c\u4e8b\u90fd\u4f1a\u53d7\u5230\u5916\u754c\u963b\u6320\uff0c\u5e76\u975e\u6613\u4e8b\u3002GM\u4f1a\u6839\u636e\u68c0\u5b9a\u7c7b\u578b\u6307\u5b9a\u4e0d\u540c\u7684 \u3010\u9608\u503c\u3011 \uff1a\u963b\u6320\u56e0\u7d20\u662f\u5916\u754c\u73af\u5883\u65f6\uff08\u5982\u6500\u722c\u5c71\u5cf0\u3001\u5fcd\u8010\u6bd2\u7d20\u7b49\uff09\uff0c\u9608\u503c\u4e3a\u56fa\u5b9a\u6570\u5b57\uff0c\u7531GM\u548c\u6a21\u7ec4\u51b3\u5b9a\uff1b\u963b\u6320\u56e0\u7d20\u662f\u5176\u4ed6\u89d2\u8272\u65f6\uff08\u5982\u653b\u51fb\u547d\u4e2d\u3001\u70b9\u7a74\u64d2\u62ff\u7b49\uff09\uff0c\u9608\u503c\u7531\u5bf9\u65b9\u7684\u7279\u5b9a\u5c5e\u6027\u8ba1\u7b97\u5f97\u51fa\uff0c\u4e14\u53ef\u80fd\u53d7\u5230\u5404\u79cd\u4e34\u65f6\u8c03\u6574\u3002\u8fd9\u901a\u5e38\u5199\u4f5c\uff1a</p> <p><code>[\u5c5e\u6027\u7b49\u7ea7 + \u6280\u80fd\u7b49\u7ea7 + \u5176\u4ed6\u8c03\u6574] vs. [\u9608\u503c]</code></p> <p>\u5c06\u68c0\u5b9a\u5f97\u5230\u7684\u6210\u529f\u6570\u4e0e\u9608\u503c\u6bd4\u8f83\uff0c\u8fbe\u5230\u6216\u8d85\u8fc7\u9608\u503c\u5747\u610f\u5473\u7740\u68c0\u5b9a\u901a\u8fc7\uff0c\u5c0f\u4e8e\u9608\u503c\u5219\u610f\u5473\u7740\u68c0\u5b9a\u5931\u8bef\u3002</p> <p>\u5728\u67d0\u4e9b\u68c0\u5b9a\u4e2d\uff0c\u8fd8\u9700\u989d\u5916\u8bb0\u5f55 \u3010\u51c0\u6210\u529f\u3011\uff1a\u68c0\u5b9a\u89d2\u8272\u7684\u6210\u529f\u6570\u6bcf\u8d85\u8fc7\u9608\u503c1\u70b9\uff0c\u8bb0\u4f5c1\u4e2a\u51c0\u6210\u529f\u3002\u51c0\u6210\u529f\u4e00\u822c\u4f1a\u5e26\u6765\u989d\u5916\u7684\u597d\u5904\uff0c\u4f8b\u5982\u653b\u51fb\u65f6\u9020\u6210\u66f4\u591a\u4f24\u5bb3\u3001\u6f5c\u884c\u65f6\u80fd\u66f4\u52a0\u9760\u8fd1\u654c\u4eba\u7b49\u3002</p> <p>\u4e0a\u8ff0\u89d2\u8272\u5728\u547d\u4e2d\u68c0\u5b9a\u4e2d\u5f97\u5230\u4e863\u4e2a\u6210\u529f\uff0c\u56e0\u4e3a\u662f\u529b\u9053\u653b\u51fb\uff0c\u5bf9\u6297\u7684\u9608\u503c\u662f\u76ee\u6807\u7684\u5378\u529b\u3002 \u5047\u8bbe\u76ee\u6807\u5378\u529b\u4e3a2\uff0c\u5219\u6b64\u6b21\u653b\u51fb\u547d\u4e2d\uff0c\u4e14\u83b7\u5f97\u4e86<code>3-2=1</code>\u4e2a\u51c0\u6210\u529f\u3002\u8fd9\u6216\u8bb8\u4f1a\u4f7f\u4ed6\u547d\u4e2d\u5bf9\u65b9\u8981\u5bb3\u3001\u589e\u52a0\u4f24\u5bb3\uff0c\u6216\u662f\u89e6\u53d1\u529f\u6cd5\u6548\u679c\u3002 \u5047\u8bbe\u76ee\u6807\u5378\u529b\u4e3a4\uff0c\u5219\u68c0\u5b9a\u5931\u8d25\uff0c\u6b64\u6b21\u653b\u51fb\u88ab\u76ee\u6807\u5316\u89e3\u3002</p> <p>\u4f8b\uff1a \u5546\u8bd5\u56fe\u6500\u4e0a\u524d\u65b9\u7684\u5ced\u58c1\uff0c\u4ed6\u8fdb\u884c\u4e00\u6b21\u5e38\u89c4\u68c0\u5b9a\u3002\u4ed6\u6709 4\u7ea7\u7075\u654f\u5c5e\u6027 \u548c 3\u7ea7\u52c7\u58ee\u6280\u80fd\uff0c\u4e8e\u662f\u4ed6\u6295\u63b7 4+3=7 \u4e2a\u516d\u9762\u9ab0\uff0c\u4ed6\u6295\u51fa\u4e86 1,1,5,6,1,1,6 \u5171\u8bb03\u4e2a\u6210\u529f\u3002\u5ced\u58c1\u5e76\u4e0d\u4f1a\u5bf9\u6500\u722c\u8005\u505a\u51fa\u53cd\u5e94\uff0c\u6545\u96be\u5ea6\u9608\u503c\u56fa\u5b9a\u3002GM\u8ba4\u4e3a\u8fd9\u4e2a\u5ced\u58c1\u5e76\u4e0d\u5371\u9669\uff0c\u8bbe\u7f6e\u7684\u9608\u503c\u662f2\uff0c\u4e8e\u662f\u5546\u6210\u529f\u6765\u5230\u9876\u7aef\u3002GM\u8ba4\u4e3a\u6b64\u65f6\u5e76\u672a\u6d89\u53ca\u8ffd\u9010\uff0c\u6545\u6ca1\u6709\u8bb0\u5f55\u51c0\u6210\u529f\u3002</p> <p>\u53cd\u4e4b\uff0c\u82e5\u5546\u8bd5\u56fe\u7528\u624b\u4e2d\u7684\u5251\u4f7f\u51fa\u4e00\u4e2a\u300c\u523a\u300d\u6765\u51fb\u4e2d\u4e00\u4e2a\u7075\u5de7\u7684\u76d7\u8d3c\uff0c\u4ed6\u6709 4\u7ea7\u7075\u654f\u5c5e\u6027 \u548c 3\u7ea7\u5251\u6cd5\u6280\u80fd\uff0c\u4e8e\u662f\u4ed6\u53c8\u6295\u63b7 4+3=7 \u4e2a\u516d\u9762\u9ab0\uff0c\u4ed6\u6295\u51fa\u4e86 1,5,5,6,1,2,6 \u5171\u8bb04\u4e2a\u6210\u529f\uff1b\u800c\u76d7\u8d3c\u7684\u300c\u95ea\u907f\u300d\u5316\u89e3\u4e3a2\uff0c\u6545\u9608\u503c\u4e3a2\u3002\u76d7\u8d3c\u7684\u62a4\u4f53\u529f\u6cd5\u5141\u8bb8\u4ed6\u4ee5\u3010\u53cd\u5e94\u52a8\u4f5c\u3011\u63d0\u9ad8\u300c\u95ea\u907f\u300d\uff0c\u8fd9\u8ba9\u4ed6\u6267\u884c\u4e00\u4e2a\u56fa\u6709\u68c0\u5b9a\uff1a\u5176\u8eab\u6cd5\u6280\u80fd\u4e3a4\u7ea7\uff0c\u6295\u63b74\u4e2a\u516d\u9762\u9ab0\uff0c\u5f97\u5230 1,2,5,3 \u5408\u8ba11\u4e2a\u6210\u529f\uff0c\u8fd9\u8ba9\u9608\u503c\u63d0\u5347\u81f33\u3002\u4e8e\u662f\uff0c\u5546\u7684\u653b\u51fb\u547d\u4e2d\u4e86\u654c\u4eba\uff0c\u4f46\u53ea\u83b7\u5f97 4-3=1 \u4e2a\u51c0\u6210\u529f\u3002</p>"},{"location":"chap01_world/#_5","title":"\u68c0\u5b9a\u79cd\u7c7b","text":"<p>\u672c\u89c4\u5219\u4e2d\u6240\u6d89\u53ca\u7684\u68c0\u5b9a\uff0c\u5747\u5c5e\u4e8e\u4ee5\u4e0b\u4e09\u8005\u4e4b\u4e00\u3002</p> <ol> <li> <p>\u5e38\u89c4\u68c0\u5b9a\uff1a\u7b26\u5408\u4e0a\u8ff0\u6d41\u7a0b\u7684\u68c0\u5b9a\u3002\u89d2\u8272\u4e3b\u52a8\u53d1\u8d77\u7684\u884c\u52a8\uff0c\u5927\u90fd\u9700\u8981\u8fdb\u884c\u5e38\u89c4\u68c0\u5b9a\u3002\u4ec5\u5e38\u89c4\u68c0\u5b9a\u6709\u5931\u8bef\u548c\u60e8\u8d25\u7684\u98ce\u9669\u3002</p> </li> <li> <p>\u56fa\u6709\u68c0\u5b9a\uff1a\u5f53\u89d2\u8272\u56e0\u654c\u5bf9\u884c\u4e3a\u6216GM\u8981\u6c42\u8fdb\u884c\u67d0\u4e9b\u88ab\u52a8\u53cd\u5e94\u65f6\uff0c\u9002\u7528\u56fa\u6709\u68c0\u5b9a\u3002\u9ab0\u6c60\u901a\u5e38\u4ec5\u7531 <code>[\u5c5e\u6027\u7b49\u7ea7]</code> \u6216 <code>[\u6280\u80fd\u7b49\u7ea7]</code> \u51b3\u5b9a\u3002\u56fa\u6709\u68c0\u5b9a\u6ca1\u6709\u6210\u529f\u6216\u5931\u8bef\u7684\u6982\u5ff5\uff0c\u4e5f\u4e0d\u4f1a\u51fa\u73b0\u60e8\u8d25\u3002\u4ec5\u7edf\u8ba1\u5f97\u5230\u7684\u6210\u529f\u6570\uff0c\u7528\u4ee5\u4f5c\u4e3a\u654c\u5bf9\u884c\u4e3a\u7684\u9608\u503c\u6216\u662f\u8c03\u6574\u5176\u4ed6\u6570\u503c\u3002</p> </li> <li> <p>\u6570\u503c\u68c0\u5b9a\uff1a\u672c\u89c4\u5219\u4e2d\uff0c\u7edd\u5927\u591a\u6570\u63b7\u9ab0\u90fd\u662f\u4e0a\u8ff0\u7684\u6210\u529f\u5ea6\u6a21\u5f0f\uff0c\u4ec5\u6709\u5c11\u6570\u65f6\u5019\u4f1a\u76f4\u63a5\u4f7f\u7528D6\u9ab0\u5b50\u7684\u51fa\u76ee\u503c\u52a0\u603b\u4f5c\u4e3a\u7ed3\u679c\uff08\u5982\u6295\u63b7\u521d\u59cb\u9b45\u529b\u3001\u6295\u63b7\u5148\u673a\u3001\u6295\u63b7\u989d\u5916\u4f24\u5bb3\u3001\u6295\u63b7\u6cbb\u7597\u91cf\u65f6\uff09\u3002</p> </li> </ol>"},{"location":"chap01_world/#_6","title":"\u60e8\u8d25","text":"<p>\u5982\u679c\u4f60\u5728\u4e00\u6b21\u5931\u8bef\u7684\u68c0\u5b9a\u4e2d\uff0c\u6210\u529f\u6570\u4e25\u683c\u4e3a0\uff0c\u4e14\u5931\u8d25\u6570\u91cf\u4e25\u683c\u5927\u4e8e\u9ab0\u6c60\u4e00\u534a\uff08\u5373\u51fa\u73b0\u4e00\u534a\u76841\uff0c\u4e14\u6ca1\u6709\u4efb\u4f555\u62166\uff09\uff0c\u5219\u8fd9\u6b21\u884c\u52a8\u5c06\u89c6\u4f5c \u3010\u60e8\u8d25\u3011 \u3002\u4e00\u822c\u800c\u8a00\uff0c\u60e8\u8d25\u7684\u51fa\u73b0\u6982\u7387\u5341\u5206\u4f4e\uff08\u5728\u9ab0\u6c60\u603b\u6570\u6781\u4f4e\u7684\u60c5\u51b5\u4e0b\uff0c\u60e8\u8d25\u7684\u6982\u7387\u624d\u4f1a\u6fc0\u589e\uff0c\u8fd9\u610f\u5473\u7740\u89d2\u8272\u5728\u505a\u5b8c\u5168\u4e0d\u64c5\u957f\u7684\u4e8b\uff09\uff0c\u56e0\u6b64\u4e5f\u5e94\u5f53\u5e26\u6765\u707e\u96be\u6027\u7684\u7ed3\u679c\uff0c\u8fd9\u9700\u8981 GM \u6784\u601d\u4e00\u4e2a\u8db3\u591f\u620f\u5267\u6027\u4e14\u6781\u5176\u51f6\u9669\u7684\u6865\u6bb5\uff0c\u4f8b\u5982\u5728\u6325\u5251\u65f6\u65e2\u6ca1\u6709\u51fb\u4e2d\u654c\u4eba\uff0c\u6b66\u5668\u4e5f\u8131\u624b\u800c\u51fa\uff0c\u8fd8\u4e0d\u614e\u626d\u4f24\u4e86\u8170\u5bfc\u81f4\u5367\u5e8a\u6570\u6708\u3002</p> <p>\u5e94\u7528\u573a\u5408\uff1a\u53ea\u6709 \u3010\u5e38\u89c4\u68c0\u5b9a\u3011 \u624d\u6709\u53ef\u80fd\u4ea7\u751f\u60e8\u8d25\u3002\u8fdb\u884c\u5176\u4ed6\u68c0\u5b9a\u65f6\uff0c\u65e0\u9700\u5173\u6ce8\u201c1\u201d\u7684\u4e2a\u6570\u3002</p> <p>\u4f8b\uff1a\u4e66\u63a5\u4e0a\u6587\uff0c \u5546\u5728\u6500\u8fc7\u5ced\u58c1\u7684\u68c0\u5b9a\u4e2d\u5f97\u5230\u4e864\u4e2a1\uff0c\u8fd9\u4e25\u683c\u5927\u4e8e\u4e86\u4ed6\u9ab0\u6c60\u603b\u65707\u7684\u4e00\u534a\uff083.5\uff09\uff0c\u6545\u4ed6\u867d\u7136\u6210\u529f\u5b8c\u6210\u672c\u6b21\u68c0\u5b9a\uff08\u5373\u6500\u4e0a\u5c71\u5d16\u8fd9\u4e2a\u4efb\u52a1\uff09\uff0c\u4f46\u662f\u4ea7\u751f\u4e86\u4e00\u4e9b\u4e0d\u597d\u7684\u4e8b\uff08\u4f8b\u5982\u5728\u6500\u722c\u65f6\u6b66\u5668\u610f\u5916\u8dcc\u843d\u3001\u53d1\u51fa\u8fc7\u5927\u7684\u58f0\u54cd\u3001\u610f\u5916\u7834\u574f\u4e86\u8e29\u8e0f\u70b9\u5bfc\u81f4\u540e\u7eed\u6500\u722c\u53d8\u5f97\u56f0\u96be\u7b49\u7b49\uff09\u3002</p> <p>\u82e5\u5546\u5f97\u5230\u7684\u7ed3\u679c\u4e3a1,1,1,2,1,1,5\uff0c\u5408\u8ba15\u4e2a1\uff0c\u4e25\u683c\u5927\u4e8e\u9ab0\u6c60\u603b\u65707\u7684\u4e00\u534a\uff0c\u6545\u4ea7\u751f\u4e86\u4e00\u4e9b\u4e0d\u597d\u7684\u4e8b\u60c5\uff08\u4f8b\u5982\u5728\u6500\u722c\u65f6\u6b66\u5668\u610f\u5916\u8dcc\u843d\u3001\u53d1\u51fa\u8fc7\u5927\u7684\u58f0\u54cd\u3001\u610f\u5916\u7834\u574f\u4e86\u8e29\u8e0f\u70b9\u5bfc\u81f4\u540e\u7eed\u6500\u722c\u53d8\u5f97\u56f0\u96be\u7b49\u7b49\uff09\uff0c\u800c\u4ec5\u5f97\u52301\u4e2a\u6210\u529f\u7684\u4ed6\u4e5f\u6ca1\u80fd\u5b8c\u6210\u672c\u6b21\u68c0\u5b9a\uff08\u5373\u6454\u56de\u539f\u5730\uff09\u3002</p> <p>\u82e5\u5546\u5f97\u5230\u7684\u7ed3\u679c\u4e3a1,1,2,2,1,1,4\uff0c\u5408\u8ba1 4\u4e2a1\uff0c\u4e25\u683c\u5927\u4e8e\u9ab0\u6c60\u603b\u65707\u7684\u4e00\u534a\uff0c\u800c\u4ed6\u4e5f\u6ca1\u83b7\u5f97\u4efb\u4f55\u6210\u529f\uff0c\u8fd9\u662f\u4e00\u6b21\u60e8\u8d25\u3002GM\u5e94\u5f53\u5b89\u6392\u6454\u5165\u5c71\u5d16\u53e6\u4e00\u4fa7\u6df1\u4e0d\u89c1\u5e95\u7684\u5e7d\u8c37\u3001\u6216\u662f\u8dcc\u56de\u539f\u5730\u65f6\u6454\u65ad\u4e86\u817f\u5bfc\u81f4\u7ec8\u751f\u6b8b\u75be\u7b49\u6865\u6bb5\u3002\u60e8\u8d25\u51fa\u73b0\u7684\u6982\u7387\u6781\u4f4e\uff0c\u6865\u6bb5\u7684\u51f6\u9669\u7a0b\u5ea6\u5e94\u4e0e\u4e4b\u5339\u914d\uff0c\u4f46\u8fd9\u5e76\u4e0d\u610f\u5473\u7740\u6495\u5361\u6216\u662f\u5192\u9669\u7684\u7ed3\u675f\uff0c\u5728\u5408\u9002\u7684\u5b89\u6392\u4e0b\u4e5f\u80fd\u5f15\u51fa\u66f4\u52a0\u66f2\u6298\u6709\u8da3\u7684\u6545\u4e8b\u3002</p>"},{"location":"chap01_world/#_7","title":"\u534f\u52a9\u548c\u534f\u540c","text":"<p>\u534f\u52a9\uff1a \u5f53\u89d2\u8272\u4eec\u8ba1\u5212\u5408\u529b\u5b8c\u6210\u4e00\u9879\u5de5\u4f5c\u65f6\uff0c\u4ed6\u4eec\u80fd\u8fdb\u884c\u3010\u534f\u52a9\u3011\uff0c\u8f83\u5f31\u8005\u4eec\u5e2e\u52a9\u8f83\u5f3a\u8005\u653b\u514b\u96be\u5173\uff1a\u4f8b\u5982\u591a\u4e2a\u533b\u5e08\u5171\u540c\u8bca\u6cbb\u4e00\u4e2a\u75c5\u4eba\u3001\u591a\u4e2a\u5de5\u5320\u4e00\u8d77\u6253\u9020\u540c\u4e2a\u6b66\u5177\u7b49\u573a\u5408\u3002\u5728\u6218\u6597\u4e2d\u7684\u534f\u52a9\u6709\u8ddd\u79bb\u9650\u5236\uff0c\u4e14\u534f\u52a9\u8005\u9700\u8981\u6d88\u8017\u989d\u5916\u7684\u52a8\u4f5c\uff1b\u5728\u6218\u6597\u5916\u7684\u534f\u52a9\u5219\u65e0\u6b64\u9650\u5236\u3002</p> <p>\u89d2\u8272\u4eec\u9700\u8981\u5728\u6295\u9ab0\u524d\u9009\u62e9\u4e00\u4e2a\u4eba\u8d1f\u8d23\u6700\u7ec8\u7684\u68c0\u5b9a\uff0c\u5176\u4f59\u89d2\u8272\u5219\u6267\u884c\u534f\u52a9\u3002\u534f\u52a9\u8005\u5404\u81ea\u8fdb\u884c\u68c0\u5b9a\uff0c\u5e76\u8bb0\u5f55\u83b7\u5f97\u7684\u6210\u529f\u6570\uff1b\u968f\u540e\uff0c\u88ab\u534f\u52a9\u8005\u8fdb\u884c\u68c0\u5b9a\uff0c\u9ab0\u6c60\u4e3a</p> <p>[\u81ea\u8eab\u9ab0\u6c60 + \u534f\u52a9\u8005\u7684\u6210\u529f\u6570\u4e4b\u548c] \u3002\u53ea\u9700\u8981\u5728\u6700\u7ec8\u68c0\u5b9a\u65f6\u8003\u8651\u5931\u8bef\u548c\u60e8\u8d25\u3002</p> <p>\u534f\u540c\uff1a \u5f53\u89d2\u8272\u4eec\u540c\u65f6\u884c\u52a8\u5e76\u4e14\u6bcf\u4eba\u5404\u81ea\u8fdb\u884c\u52aa\u529b\u65f6\uff0c\u4ed6\u4eec\u80fd\u8fdb\u884c\u3010\u534f\u540c\u3011\uff0c\u8f83\u5f3a\u8005\u4eec\u5e2e\u52a9\u8f83\u5f31\u8005\u4ee5\u907f\u514d\u77ed\u677f\u6548\u5e94\uff1a\u4f8b\u5982\u591a\u4e2a\u89d2\u8272\u51c6\u5907\u540c\u65f6\u8dc3\u8fc7\u5ce1\u8c37\u3001\u4e00\u8d77\u6f5c\u5165\u654c\u8425\u907f\u514d\u53d1\u51fa\u58f0\u54cd\u7b49\u573a\u5408\u3002\u534f\u540c\u4e00\u822c\u5e38\u89c1\u4e8e\u6218\u6597\u5916\u7684\u6280\u80fd\u8003\u9a8c\u4e0a\u3002</p> <p>\u89d2\u8272\u4eec\u5404\u81ea\u7684\u9ab0\u6c60\u52a0\u603b\uff0c\u53d6\u5e73\u5747\u503c\u5e76\u5411\u4e0a\u53d6\u6574\uff0c\u4ee5\u56e2\u4f53\u8fdb\u884c\u5355\u6b21\u68c0\u5b9a\u3002\u5f53\u7136\uff0c\u89d2\u8272\u4eec\u4e5f\u80fd\u653e\u5f03\u534f\u540c\uff0c\u5404\u81ea\u72ec\u7acb\u8fdb\u884c\u68c0\u5b9a\u3002</p> <p>\u6ce8\uff1a\u53e6\u4e00\u65b9\u9762\uff0c\u50cf\u662f\u641c\u7d22\u5bc6\u95e8\u3001\u5bdf\u89c9\u57cb\u4f0f\u7b49\u68c0\u5b9a\uff0c\u5e94\u5f53\u7531\u89d2\u8272\u4eec\u5404\u81ea\u72ec\u7acb\u8fdb\u884c\u66f4\u52a0\u5408\u7406\uff0c\u4e14\u80fd\u591f\u5206\u6563\u98ce\u9669\uff0c\u589e\u52a0\u6210\u529f\u7684\u53ef\u80fd\u3002</p>"},{"location":"chap02_learning/","title":"\u4fee\u6587\u4e60\u6b66","text":"<p>\u5185\u5bb9\u6574\u7406\u4e2d\u3002</p>"},{"location":"chap03_character/","title":"\u89d2\u8272\u521b\u5efa","text":"<p>\u5185\u5bb9\u6574\u7406\u4e2d\u3002</p>"},{"location":"chap04_jianghu/","title":"\u6c5f\u6e56","text":"<p>\u5185\u5bb9\u6574\u7406\u4e2d\u3002</p>"},{"location":"chap05_equipment/","title":"\u88c5\u5907\u9053\u5177","text":"<p>\u5185\u5bb9\u6574\u7406\u4e2d\u3002</p>"},{"location":"chap06_modules/","title":"\u8303\u4f8b\u6a21\u7ec4","text":"<p>\u5185\u5bb9\u6574\u7406\u4e2d\u3002</p>"}]}